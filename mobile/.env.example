# Physical phone on the same Wi-Fi: set your actual computer LAN address.
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_ADDRESS:5000/api
# Production: set the actual HTTPS API origin (with optional /api).
EXPO_PUBLIC_API_URL=
# Actual project UUID from `npx eas-cli init`; optional for local Expo Go.
EAS_PROJECT_ID=
# Local path or EAS secret file variable. Never put FCM service-account keys here.
GOOGLE_SERVICES_JSON=
