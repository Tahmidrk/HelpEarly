# Use this for one shared online PostgreSQL database.
# Put the same DATABASE_URL on every PC that should share accounts, bans, bookings, and chats.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Local database fallback. These are ignored when DATABASE_URL is set.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=at_your_service

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# Server
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173,http://localhost:8081

# In production, set CLIENT_URL to your deployed frontend URL.
# For multiple allowed frontends, separate them with commas:
# CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# AI Chatbot (Google Gemini)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

UPLOAD_DIR=
# Production reverse proxy only; direct local access leaves this unset.
TRUST_PROXY=0
# Hosted PostgreSQL verifies TLS by default. Supply the provider CA if required.
DB_SSL_CA=
# Explicit exception for a provider's self-signed certificate; avoid in production.
DB_SSL_ALLOW_SELF_SIGNED=false
# Leave disabled until real EAS/FCM credentials and a device are configured.
PUSH_ENABLED=false
# Enable enhanced push security in Expo and set its access token only on the server.
EXPO_ACCESS_TOKEN=
